{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [],
  "dependencyDashboard": false,
  "enabledManagers": ["npm"],
  "ignoreDeps": ["pnpm"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["lodash"],
      "postUpgradeTasks": {
        "commands": ["node scripts/verify-npmrc.cjs"],
        "executionMode": "branch",
        "fileFilters": ["**/*"]
      }
    }
  ]
}
